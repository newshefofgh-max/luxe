# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Luxe Accessories
NODE_ENV=development

# ─── MongoDB (required) ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/luxe-accessories?retryWrites=true&w=majority

# ─── JWT (required) ───────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable, "false" to disable each feature.
# You can start with everything false and enable as you set up each service.

ENABLE_WHATSAPP=false
ENABLE_SMS=false
ENABLE_BOSTA_SHIPPING=false
ENABLE_CLOUDINARY=false
ENABLE_RATE_LIMIT=true

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
# Required only if ENABLE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Required only if ENABLE_WHATSAPP=true
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
ADMIN_WHATSAPP_NUMBER=201XXXXXXXXX

# ─── SMS / OTP fallback (Unifonic) ───────────────────────────────────────────
# Required only if ENABLE_SMS=true
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.unifonic.com/rest/SMS/messages
SMS_SENDER_ID=LuxeStore

# ─── Bosta Shipping ───────────────────────────────────────────────────────────
# Required only if ENABLE_BOSTA_SHIPPING=true
BOSTA_API_KEY=your-bosta-api-key
BOSTA_API_URL=https://app.bosta.co/api/v2
BOSTA_CITY_CODE=EG-01

# ─── Redis rate limiting ──────────────────────────────────────────────────────
# Required only if ENABLE_RATE_LIMIT=true (uses in-memory fallback if not set)
REDIS_URL=redis://localhost:6379

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourstore.eg
ADMIN_PASSWORD=change-this-in-production
